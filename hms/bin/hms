#!/usr/bin/env bash
# HMS CLI wrapper - Executes commands inside running HMS container
# Daemon management is handled via "hms daemon" Python plugin
set -euo pipefail

# Resolve repo root from this script path
SCRIPT_PATH="${BASH_SOURCE[0]}"
resolve_realpath() {
  local target="$1"
  local dir
  while [ -L "$target" ]; do
    target="$(readlink "$target")"
  done
  dir="$(cd "$(dirname "$target")" && pwd)"
  echo "$dir/$(basename "$target")"
}
REALPATH="$(resolve_realpath "$SCRIPT_PATH")"
REPO_ROOT="$(cd "$(dirname "$REALPATH")/../.." && pwd)"

COMPOSE_DIR="$REPO_ROOT/docker/hms"
CONTAINER_NAME="hms"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_error() { echo -e "${RED}❌ $*${NC}" >&2; }

# Ensure Docker is available
if ! command -v docker >/dev/null 2>&1; then
  log_error "Docker no está instalado en el host"
  exit 1
fi

# Ensure Docker daemon is reachable
if ! docker info >/dev/null 2>&1; then
  log_error "Docker daemon no disponible. Abre Docker Desktop e inténtalo de nuevo."
  exit 1
fi

# Ensure .env exists (generated by install.sh)
if [ ! -f "$COMPOSE_DIR/.env" ]; then
  log_error "No se encontró $COMPOSE_DIR/.env"
  log_error "Ejecuta ./install.sh primero para generar el archivo de configuración"
  exit 1
fi

# Verify HMS container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  log_error "El contenedor HMS no está corriendo"
  log_error "Ejecuta: cd $COMPOSE_DIR && docker compose up -d"
  exit 1
fi

# Detect TTY for docker flags
DOCKER_FLAGS=""
if [ -t 1 ]; then
  DOCKER_FLAGS="-it"
fi

# Execute command inside running HMS container
exec docker exec $DOCKER_FLAGS "$CONTAINER_NAME" python -m hms "$@"
