#!/usr/bin/env bash
# HMS CLI wrapper - Executes commands inside running HMS container
# Handles start/stop specially (runs on host before/after container)
set -euo pipefail

# Resolve repo root from this script path
SCRIPT_PATH="${BASH_SOURCE[0]}"
resolve_realpath() {
  local target="$1"
  local dir
  while [ -L "$target" ]; do
    target="$(readlink "$target")"
  done
  dir="$(cd "$(dirname "$target")" && pwd)"
  echo "$dir/$(basename "$target")"
}
REALPATH="$(resolve_realpath "$SCRIPT_PATH")"
REPO_ROOT="$(cd "$(dirname "$REALPATH")/../.." && pwd)"

CONTAINER_NAME="hms"
CONFIG_FILE="$REPO_ROOT/config.toml"
COMMANDS_DIR="$(dirname "$REALPATH")/commands"

# Colors
RED='\033[0;31m'
NC='\033[0m'

log_error() { echo -e "${RED}❌ $*${NC}" >&2; }

# Ensure Docker is available
if ! command -v docker >/dev/null 2>&1; then
  log_error "Docker no está instalado en el host"
  exit 1
fi

# Ensure Docker daemon is reachable
if ! docker info >/dev/null 2>&1; then
  log_error "Docker daemon no disponible. Abre Docker Desktop e inténtalo de nuevo."
  exit 1
fi

# Ensure config.toml exists (generated by install.sh)
if [ ! -f "$CONFIG_FILE" ]; then
  log_error "No se encontró $CONFIG_FILE"
  log_error "Ejecuta ./install.sh primero para configurar el sistema"
  exit 1
fi

# Check if command is start, stop, install, update, or uninstall (special handling)
COMMAND="${1:-}"
if [ "$COMMAND" = "start" ]; then
  # Execute start command (starts container if needed)
  shift
  exec "$COMMANDS_DIR/start" "$@"
elif [ "$COMMAND" = "stop" ]; then
  # Execute stop command (stops container and services)
  shift
  exec "$COMMANDS_DIR/stop" "$@"
elif [ "$COMMAND" = "install" ]; then
  # Execute install command (sets up symlink and config)
  shift
  exec "$COMMANDS_DIR/install" "$@"
elif [ "$COMMAND" = "update" ]; then
  # Execute update command (pulls repo and restarts HMS)
  shift
  exec "$COMMANDS_DIR/update" "$@"
elif [ "$COMMAND" = "uninstall" ]; then
  # Execute uninstall command (removes symlink and stops HMS)
  shift
  exec "$COMMANDS_DIR/uninstall" "$@"
fi

# For all other commands, verify HMS container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  log_error "El contenedor HMS no está corriendo"
  log_error "Ejecuta: hms start"
  exit 1
fi

# Detect TTY for docker flags
DOCKER_FLAGS=""
if [ -t 1 ]; then
  DOCKER_FLAGS="-it"
fi

# Execute command inside running HMS container
exec docker exec $DOCKER_FLAGS "$CONTAINER_NAME" python -m hms "$@"

