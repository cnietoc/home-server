#!/usr/bin/env bash
# HMS Stop Command - stops internal services and the HMS container
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
COMPOSE_DIR="$REPO_ROOT/core/hms"
CONTAINER_NAME="hms"
CONFIG_FILE="$REPO_ROOT/config.toml"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}➜${NC} $*"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }

# Validate Docker is available
if ! command -v docker >/dev/null 2>&1; then
  log_error "Docker is not installed"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  log_error "Docker daemon is not available"
  exit 1
fi

# Check if container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  log_warn "HMS container is not running"
  exit 0
fi

read_global_config() {
  local key="$1"
  local config_file="$CONFIG_FILE"

  if [ ! -f "$config_file" ]; then
    echo ""
    return 1
  fi

  local quote="'"

  awk -v key="$key" -v q="$quote" '
    /^\[global\]/ { in_global=1; next }
    /^\[/ { in_global=0 }
    in_global && $0 ~ "^"key" *= *" {
      sub(/^[^=]*= */, "")
      gsub("^[\""q"]|[\""q"]$", "")
      print
      exit
    }
  ' "$config_file"
}

# Read config.toml to get required parameters
PUID=$(read_global_config "puid" || echo "")
PGID=$(read_global_config "pgid" || echo "")
DOCKER_GID=$(read_global_config "docker_gid" || echo "")

export PUID PGID DOCKER_GID

# Run stop command inside container
docker exec "$CONTAINER_NAME" python -m hms stop "$@"

# Stop the container
log_info "Stopping HMS container..."
(cd "$COMPOSE_DIR" && docker compose down --remove-orphans)

log_info "✅ HMS stopped successfully"
