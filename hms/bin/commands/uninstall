#!/usr/bin/env bash
# HMS Uninstall Command - runs hms stop and removes symlink
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
USER_BIN="$HOME/.local/bin"
WRAPPER="$USER_BIN/hms"
WRAPPER_SRC="$REPO_ROOT/hms/bin/hms"

# Output colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🗑️  HMS Uninstaller"
echo ""

# Run hms stop using the binary directly (not symlink)
echo "⏹️  Stopping HMS..."
if [ -f "$WRAPPER_SRC" ]; then
    "$WRAPPER_SRC" stop 2>/dev/null || {
        echo -e "${YELLOW}⚠️  Failed to run hms stop${NC}"
    }
else
    echo -e "${YELLOW}⚠️  Wrapper not found at $WRAPPER_SRC${NC}"
fi

echo ""

# Remove symlink
if [ -L "$WRAPPER" ]; then
    rm -f "$WRAPPER"
    echo -e "${GREEN}✅ Symlink removed: $WRAPPER${NC}"
elif [ -e "$WRAPPER" ]; then
    echo -e "${YELLOW}⚠️  $WRAPPER exists but is not a symlink. Not removed automatically.${NC}"
else
    echo -e "${YELLOW}ℹ️  No symlink found at $WRAPPER${NC}"
fi

# Remove tab completion (both shells)
ZSH_COMPLETION="$HOME/.zsh/completions/_hms"
BASH_COMPLETION="$HOME/.bash_completion.d/hms"
REMOVED=false

if [ -f "$ZSH_COMPLETION" ]; then
    rm -f "$ZSH_COMPLETION"
    echo -e "${GREEN}✅ Tab completion (zsh) removed: $ZSH_COMPLETION${NC}"
    REMOVED=true
fi
if [ -f "$BASH_COMPLETION" ]; then
    rm -f "$BASH_COMPLETION"
    echo -e "${GREEN}✅ Tab completion (bash) removed: $BASH_COMPLETION${NC}"
    REMOVED=true
fi
if [ "$REMOVED" = false ]; then
    echo -e "${YELLOW}ℹ️  No completion files found${NC}"
fi

echo ""
echo -e "${GREEN}✅ Uninstall complete${NC}"
