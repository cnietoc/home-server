#!/usr/bin/env bash
# HMS Update Command - pull from repo and rebuild container if there are changes
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
STOP_CMD="$REPO_ROOT/hms/bin/commands/stop"
START_CMD="$REPO_ROOT/hms/bin/commands/start"

# Output colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔄 HMS Updater${NC}"
echo ""

# Validate we are in the correct repo
if [ ! -d "$REPO_ROOT/.git" ]; then
    echo -e "${RED}❌ No .git directory found in $REPO_ROOT${NC}"
    exit 1
fi

# Validate Docker is available
if ! command -v docker &> /dev/null; then
    echo -e "${RED}❌ Docker is not installed on the host${NC}"
    exit 1
fi

if ! docker info &> /dev/null; then
    echo -e "${YELLOW}⚠️  Docker daemon is not available. Cannot update HMS.${NC}"
    exit 1
fi

# Save hash before pull
echo "📊 Comparing changes..."
HASH_BEFORE=$(git -C "$REPO_ROOT" rev-parse HEAD)

# Git pull
echo "⬇️  Running git pull..."
if ! git -C "$REPO_ROOT" pull; then
    echo -e "${RED}❌ git pull failed. Please resolve any conflicts manually.${NC}"
    exit 1
fi

HASH_AFTER=$(git -C "$REPO_ROOT" rev-parse HEAD)

# If hash didn't change, nothing to do
if [ "$HASH_BEFORE" = "$HASH_AFTER" ]; then
    echo -e "${YELLOW}ℹ️  Repository was already up to date; restarting anyway${NC}"
fi

# Detect relevant changes
CHANGED_FILES=$(git -C "$REPO_ROOT" diff --name-only $HASH_BEFORE..$HASH_AFTER)

if echo "$CHANGED_FILES" | grep -qE '^hms/|^core/hms/|^pyproject\.toml|^requirements\.txt'; then
    echo "📦 Changes detected in HMS code:"
    echo "$CHANGED_FILES" | grep -E '^hms/|^core/hms/|^pyproject\.toml|^requirements\.txt' || true
else
    echo -e "${GREEN}ℹ️  No relevant changes in HMS code${NC}"
fi

# Restart HMS using system commands
echo ""
echo -e "${BLUE}🔄 Restarting HMS...${NC}"

# Stop HMS
echo "🛑 Stopping HMS..."
if ! "$STOP_CMD"; then
    echo -e "${RED}❌ Error stopping HMS${NC}"
    exit 1
fi

echo ""

# Start HMS (will rebuild image if needed)
echo "🚀 Starting HMS..."
if ! "$START_CMD"; then
    echo -e "${RED}❌ Error starting HMS${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ Update complete${NC}"
if [ -n "$CHANGED_FILES" ]; then
    echo -e "${GREEN}Applied changes:${NC}"
    echo "$CHANGED_FILES"
fi
