#!/usr/bin/env bash
# HMS Install Command - crea symlink en ~/.local/bin/hms y prepara config.toml
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
USER_BIN="$HOME/.local/bin"
WRAPPER_SRC="$REPO_ROOT/hms/bin/hms"
COMPOSE_DIR="$REPO_ROOT/core/hms"
CONFIG_FILE="$REPO_ROOT/config.toml"
FORCE="${1:-}"

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🚀 Instalador HMS"
echo ""

# Validar Docker
if ! command -v docker &> /dev/null; then
    echo -e "${RED}❌ Docker no está instalado en el host${NC}"
    exit 1
fi

if ! docker info &> /dev/null; then
    echo -e "${RED}❌ Docker daemon no disponible. Abre Docker Desktop e inténtalo de nuevo.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Docker disponible${NC}"

# Validar compose
if [ ! -f "$COMPOSE_DIR/docker-compose.yml" ]; then
    echo -e "${RED}❌ No se encontró docker-compose en: $COMPOSE_DIR/docker-compose.yml${NC}"
    exit 1
fi
echo -e "${GREEN}✅ docker-compose.yml encontrado${NC}"

# Validar wrapper fuente
if [ ! -f "$WRAPPER_SRC" ]; then
    echo -e "${RED}❌ No se encontró wrapper fuente en: $WRAPPER_SRC${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Wrapper fuente encontrado${NC}"

# Crear ~/.local/bin si no existe
mkdir -p "$USER_BIN"
echo -e "${GREEN}✅ ~/.local/bin listo${NC}"

# Verificar si el symlink ya existe
TARGET="$USER_BIN/hms"
if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
    if [ "$FORCE" != "--force" ]; then
        echo -e "${RED}❌ $TARGET ya existe. Usa --force para sobrescribir.${NC}"
        exit 1
    fi
    rm -f "$TARGET"
    echo "⚠️  Symlink anterior eliminado"
fi

# Crear symlink
ln -s "$WRAPPER_SRC" "$TARGET"
echo -e "${GREEN}✅ Symlink creado: $TARGET -> $WRAPPER_SRC${NC}"

# Verificar PATH contiene ~/.local/bin
if [[ ":$PATH:" != *":$USER_BIN:"* ]]; then
    echo -e "${YELLOW}⚠️  ~/.local/bin no está en PATH${NC}"
    echo ""
    echo "Añade esta línea a tu ~/.zshrc:"
    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "Luego ejecuta:"
    echo "    source ~/.zshrc"
    exit 1
fi
echo -e "${GREEN}✅ ~/.local/bin está en PATH${NC}"

# Validar permisos de Docker
HOST_OS=$(uname -s)
if [ "$HOST_OS" = "Darwin" ]; then
    echo "ℹ️ macOS detectado: Docker Desktop no usa el grupo 'docker' del host"
    echo "   Se omitirá la verificación de grupo"
else
    echo ""
    echo "🔐 Validando permisos de Docker..."
    if ! groups | grep -q docker; then
        echo -e "${YELLOW}⚠️  Tu usuario no está en el grupo 'docker'${NC}"
        echo ""
        echo "Para agregar tu usuario al grupo docker ejecuta:"
        echo "    sudo usermod -aG docker $USER"
        echo ""
        echo "Luego cierra sesión y vuelve a iniciar sesión para aplicar los cambios."
        echo ""
        read -p "¿Continuar de todas formas? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    else
        echo -e "${GREEN}✅ Usuario en grupo docker${NC}"
    fi
fi

# Generar o actualizar config.toml
echo ""
echo "📝 Configurando config.toml..."

CURRENT_UID=$(id -u)
CURRENT_GID=$(id -g)
if command -v getent >/dev/null 2>&1 && getent group docker >/dev/null 2>&1; then
    DOCKER_GID=$(getent group docker | cut -d: -f3)
else
    DOCKER_GID=0
fi

# Detectar timezone del sistema
if [ -f /etc/timezone ]; then
    SYSTEM_TZ=$(cat /etc/timezone)
elif [ -L /etc/localtime ]; then
    SYSTEM_TZ=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
else
    SYSTEM_TZ="UTC"
fi

if [ ! -f "$CONFIG_FILE" ]; then
    # Crear config.toml básico si no existe
    cat > "$CONFIG_FILE" << EOF
[global]
host_root = "$REPO_ROOT"
puid = $CURRENT_UID
pgid = $CURRENT_GID
docker_gid = $DOCKER_GID
tz = "$SYSTEM_TZ"
EOF
    echo -e "${GREEN}✅ config.toml creado con valores básicos${NC}"
fi

# Actualizar puid, pgid, docker_gid y tz en config.toml existente
if [ -f "$CONFIG_FILE" ]; then
    # Función auxiliar para actualizar o agregar campo en una sección
    update_toml_field() {
        local file="$1"
        local section="$2"
        local key="$3"
        local value="$4"

        awk -v section="[$section]" -v key="$key" -v value="$value" '
        BEGIN { in_section=0; done=0 }
        /^\[.*\]/ {
            if ($0 == section) in_section=1
            else if (in_section && !done) {
                print key " = " value
                done=1
                in_section=0
            }
            print
            next
        }
        /^[[:space:]]*'"$key"'[[:space:]]*=/ && in_section {
            print key " = " value
            done=1
            next
        }
        { print }
        END {
            if (in_section && !done)
                print key " = " value
        }
        ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    }

    # Actualizar campos en sección [global]
    update_toml_field "$CONFIG_FILE" "global" "puid" "$CURRENT_UID"
    update_toml_field "$CONFIG_FILE" "global" "pgid" "$CURRENT_GID"
    update_toml_field "$CONFIG_FILE" "global" "docker_gid" "$DOCKER_GID"
    update_toml_field "$CONFIG_FILE" "global" "tz" "\"$SYSTEM_TZ\""
    update_toml_field "$CONFIG_FILE" "global" "host_root" "\"$REPO_ROOT\""

    echo -e "${GREEN}✅ config.toml actualizado con PUID=$CURRENT_UID, PGID=$CURRENT_GID, DOCKER_GID=$DOCKER_GID, TZ=$SYSTEM_TZ, HOST_ROOT=$REPO_ROOT${NC}"

    # Detectar IP LAN del host
    LAN_IP=""
    if command -v ip >/dev/null 2>&1; then
        LAN_IP=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7; exit}')
    fi
    if [ -z "$LAN_IP" ] && command -v ipconfig >/dev/null 2>&1; then
        # macOS: probar en0 (ethernet/wifi) y en1
        LAN_IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
    fi
    if [ -z "$LAN_IP" ]; then
        LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi

    if [ -n "$LAN_IP" ]; then
        update_toml_field "$CONFIG_FILE" "global" "host_ip" "\"$LAN_IP\""
        echo -e "${GREEN}✅ IP del host detectada: $LAN_IP → global.host_ip${NC}"
    else
        echo -e "${YELLOW}⚠️  No se pudo detectar la IP del host. Añade manualmente a config.toml:${NC}"
        echo "       [global]"
        echo "       host_ip = \"192.168.X.X\""
    fi
else
    echo -e "${YELLOW}⚠️  config.toml no existe${NC}"
fi

# Instalar tab completion según el shell del usuario
echo ""
echo "⌨️  Configurando tab completion..."
CURRENT_SHELL="$(basename "${SHELL:-bash}")"

if [ "$CURRENT_SHELL" = "zsh" ]; then
    ZSH_COMPLETIONS_DIR="$HOME/.zsh/completions"
    COMPLETION_FILE="$ZSH_COMPLETIONS_DIR/_hms"
    mkdir -p "$ZSH_COMPLETIONS_DIR"
    cat > "$COMPLETION_FILE" << 'COMPLETION_EOF'
#compdef hms

_hms() {
    local completions
    completions=$(hms --complete "$CURRENT" "${words[@]}" 2>/dev/null)

    if [[ -n "$completions" ]]; then
        local -a items
        items=(${(f)completions})
        _describe 'hms' items
    fi
}

_hms
COMPLETION_EOF
    echo -e "${GREEN}✅ Tab completion instalado en $COMPLETION_FILE${NC}"

    ZSHRC="$HOME/.zshrc"
    FPATH_LINE='fpath=(~/.zsh/completions $fpath)'
    COMPINIT_LINE='autoload -Uz compinit && compinit'
    if [ -f "$ZSHRC" ] && grep -qF "$FPATH_LINE" "$ZSHRC"; then
        echo -e "${GREEN}✅ fpath ya configurado en ~/.zshrc${NC}"
    else
        echo -e "${YELLOW}⚠️  Añade esto a tu ~/.zshrc para activar el autocompletado:${NC}"
        echo ""
        echo "    $FPATH_LINE"
        echo "    $COMPINIT_LINE"
        echo ""
        echo "    Luego ejecuta: exec zsh"
    fi

else
    # bash (default en Ubuntu)
    BASH_COMPLETIONS_DIR="$HOME/.bash_completion.d"
    COMPLETION_FILE="$BASH_COMPLETIONS_DIR/hms"
    mkdir -p "$BASH_COMPLETIONS_DIR"
    cat > "$COMPLETION_FILE" << 'COMPLETION_EOF'
# HMS bash completion

_hms() {
    local completions
    completions=$(hms --complete "$((COMP_CWORD + 1))" "${COMP_WORDS[@]}" 2>/dev/null)
    COMPREPLY=($(compgen -W "$completions" -- "${COMP_WORDS[$COMP_CWORD]}"))
}

complete -F _hms hms
COMPLETION_EOF
    echo -e "${GREEN}✅ Tab completion instalado en $COMPLETION_FILE${NC}"

    BASHRC="$HOME/.bashrc"
    SOURCE_LINE="source $COMPLETION_FILE"
    if [ -f "$BASHRC" ] && grep -qF "$COMPLETION_FILE" "$BASHRC"; then
        echo -e "${GREEN}✅ completion ya configurado en ~/.bashrc${NC}"
    else
        echo "$SOURCE_LINE" >> "$BASHRC"
        echo -e "${GREEN}✅ Añadido source a ~/.bashrc${NC}"
        echo -e "${YELLOW}ℹ️  Ejecuta 'source ~/.bashrc' o abre una nueva terminal para activarlo${NC}"
    fi
fi

# Finalizar
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Instalación completada${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "Siguiente paso:"
echo -e "  ${GREEN}hms start${NC}    # Inicia el contenedor HMS"
echo ""
echo "Después podrás usar:"
echo "  hms list          # Listar stacks disponibles"
echo "  hms <stack> up    # Levantar un stack"
echo "  hms stop          # Detener HMS"
echo ""
