#!/usr/bin/env bash
# HMS Install Command - creates symlink in ~/.local/bin/hms and sets up config.toml
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
USER_BIN="$HOME/.local/bin"
WRAPPER_SRC="$REPO_ROOT/hms/bin/hms"
COMPOSE_DIR="$REPO_ROOT/core/hms"
CONFIG_FILE="$REPO_ROOT/config.toml"
FORCE="${1:-}"

# Output colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🚀 HMS Installer"
echo ""

# Validate Docker
if ! command -v docker &> /dev/null; then
    echo -e "${RED}❌ Docker is not installed on the host${NC}"
    exit 1
fi

if ! docker info &> /dev/null; then
    echo -e "${RED}❌ Docker daemon is not available. Open Docker Desktop and try again.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Docker available${NC}"

# Validate compose
if [ ! -f "$COMPOSE_DIR/docker-compose.yml" ]; then
    echo -e "${RED}❌ docker-compose not found at: $COMPOSE_DIR/docker-compose.yml${NC}"
    exit 1
fi
echo -e "${GREEN}✅ docker-compose.yml found${NC}"

# Validate source wrapper
if [ ! -f "$WRAPPER_SRC" ]; then
    echo -e "${RED}❌ Source wrapper not found at: $WRAPPER_SRC${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Source wrapper found${NC}"

# Create ~/.local/bin if it doesn't exist
mkdir -p "$USER_BIN"
echo -e "${GREEN}✅ ~/.local/bin ready${NC}"

# Check if symlink already exists
TARGET="$USER_BIN/hms"
if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
    if [ "$FORCE" != "--force" ]; then
        echo -e "${RED}❌ $TARGET already exists. Use --force to overwrite.${NC}"
        exit 1
    fi
    rm -f "$TARGET"
    echo "⚠️  Previous symlink removed"
fi

# Create symlink
ln -s "$WRAPPER_SRC" "$TARGET"
echo -e "${GREEN}✅ Symlink created: $TARGET -> $WRAPPER_SRC${NC}"

# Verify PATH contains ~/.local/bin
if [[ ":$PATH:" != *":$USER_BIN:"* ]]; then
    echo -e "${YELLOW}⚠️  ~/.local/bin is not in PATH${NC}"
    echo ""
    echo "Add this line to your ~/.zshrc:"
    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "Then run:"
    echo "    source ~/.zshrc"
    exit 1
fi
echo -e "${GREEN}✅ ~/.local/bin is in PATH${NC}"

# Validate Docker permissions
HOST_OS=$(uname -s)
if [ "$HOST_OS" = "Darwin" ]; then
    echo "ℹ️ macOS detected: Docker Desktop does not use the host 'docker' group"
    echo "   Skipping group permission check"
else
    echo ""
    echo "🔐 Validating Docker permissions..."
    if ! groups | grep -q docker; then
        echo -e "${YELLOW}⚠️  Your user is not in the 'docker' group${NC}"
        echo ""
        echo "To add your user to the docker group run:"
        echo "    sudo usermod -aG docker $USER"
        echo ""
        echo "Then log out and back in for the changes to take effect."
        echo ""
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    else
        echo -e "${GREEN}✅ User is in docker group${NC}"
    fi
fi

# Generate or update config.toml
echo ""
echo "📝 Configuring config.toml..."

CURRENT_UID=$(id -u)
CURRENT_GID=$(id -g)
if command -v getent >/dev/null 2>&1 && getent group docker >/dev/null 2>&1; then
    DOCKER_GID=$(getent group docker | cut -d: -f3)
else
    DOCKER_GID=0
fi

# Detect system timezone
if [ -f /etc/timezone ]; then
    SYSTEM_TZ=$(cat /etc/timezone)
elif [ -L /etc/localtime ]; then
    SYSTEM_TZ=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
else
    SYSTEM_TZ="UTC"
fi

if [ ! -f "$CONFIG_FILE" ]; then
    # Create minimal config.toml if not present
    cat > "$CONFIG_FILE" << EOF
[global]
host_root = "$REPO_ROOT"
puid = $CURRENT_UID
pgid = $CURRENT_GID
docker_gid = $DOCKER_GID
tz = "$SYSTEM_TZ"
EOF
    echo -e "${GREEN}✅ config.toml created with default values${NC}"
fi

# Update puid, pgid, docker_gid and tz in existing config.toml
if [ -f "$CONFIG_FILE" ]; then
    # Helper function to update or add a field in a section
    update_toml_field() {
        local file="$1"
        local section="$2"
        local key="$3"
        local value="$4"

        awk -v section="[$section]" -v key="$key" -v value="$value" '
        BEGIN { in_section=0; done=0 }
        /^\[.*\]/ {
            if ($0 == section) in_section=1
            else if (in_section && !done) {
                print key " = " value
                done=1
                in_section=0
            }
            print
            next
        }
        /^[[:space:]]*'"$key"'[[:space:]]*=/ && in_section {
            print key " = " value
            done=1
            next
        }
        { print }
        END {
            if (in_section && !done)
                print key " = " value
        }
        ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    }

    # Update fields in [global] section
    update_toml_field "$CONFIG_FILE" "global" "puid" "$CURRENT_UID"
    update_toml_field "$CONFIG_FILE" "global" "pgid" "$CURRENT_GID"
    update_toml_field "$CONFIG_FILE" "global" "docker_gid" "$DOCKER_GID"
    update_toml_field "$CONFIG_FILE" "global" "tz" "\"$SYSTEM_TZ\""
    update_toml_field "$CONFIG_FILE" "global" "host_root" "\"$REPO_ROOT\""

    echo -e "${GREEN}✅ config.toml updated: PUID=$CURRENT_UID, PGID=$CURRENT_GID, DOCKER_GID=$DOCKER_GID, TZ=$SYSTEM_TZ, HOST_ROOT=$REPO_ROOT${NC}"

    # Detect host LAN IP
    LAN_IP=""
    if command -v ip >/dev/null 2>&1; then
        LAN_IP=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7; exit}')
    fi
    if [ -z "$LAN_IP" ] && command -v ipconfig >/dev/null 2>&1; then
        # macOS: try en0 (ethernet/wifi) and en1
        LAN_IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
    fi
    if [ -z "$LAN_IP" ]; then
        LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi

    if [ -n "$LAN_IP" ]; then
        update_toml_field "$CONFIG_FILE" "global" "host_ip" "\"$LAN_IP\""
        echo -e "${GREEN}✅ Host IP detected: $LAN_IP → global.host_ip${NC}"
    else
        echo -e "${YELLOW}⚠️  Could not detect host IP. Add it manually to config.toml:${NC}"
        echo "       [global]"
        echo "       host_ip = \"192.168.X.X\""
    fi
else
    echo -e "${YELLOW}⚠️  config.toml not found${NC}"
fi

# Install tab completion for the user's shell
echo ""
echo "⌨️  Setting up tab completion..."
CURRENT_SHELL="$(basename "${SHELL:-bash}")"

if [ "$CURRENT_SHELL" = "zsh" ]; then
    ZSH_COMPLETIONS_DIR="$HOME/.zsh/completions"
    COMPLETION_FILE="$ZSH_COMPLETIONS_DIR/_hms"
    mkdir -p "$ZSH_COMPLETIONS_DIR"
    cat > "$COMPLETION_FILE" << 'COMPLETION_EOF'
#compdef hms

_hms() {
    local completions
    completions=$(hms --complete "$CURRENT" "${words[@]}" 2>/dev/null)

    if [[ -n "$completions" ]]; then
        local -a items
        items=(${(f)completions})
        _describe 'hms' items
    fi
}

_hms
COMPLETION_EOF
    echo -e "${GREEN}✅ Tab completion installed at $COMPLETION_FILE${NC}"

    ZSHRC="$HOME/.zshrc"
    FPATH_LINE='fpath=(~/.zsh/completions $fpath)'
    COMPINIT_LINE='autoload -Uz compinit && compinit'
    if [ -f "$ZSHRC" ] && grep -qF "$FPATH_LINE" "$ZSHRC"; then
        echo -e "${GREEN}✅ fpath already configured in ~/.zshrc${NC}"
    else
        echo -e "${YELLOW}⚠️  Add this to your ~/.zshrc to enable tab completion:${NC}"
        echo ""
        echo "    $FPATH_LINE"
        echo "    $COMPINIT_LINE"
        echo ""
        echo "    Then run: exec zsh"
    fi

else
    # bash (default on Ubuntu)
    BASH_COMPLETIONS_DIR="$HOME/.bash_completion.d"
    COMPLETION_FILE="$BASH_COMPLETIONS_DIR/hms"
    mkdir -p "$BASH_COMPLETIONS_DIR"
    cat > "$COMPLETION_FILE" << 'COMPLETION_EOF'
# HMS bash completion

_hms() {
    local completions
    completions=$(hms --complete "$((COMP_CWORD + 1))" "${COMP_WORDS[@]}" 2>/dev/null)
    COMPREPLY=($(compgen -W "$completions" -- "${COMP_WORDS[$COMP_CWORD]}"))
}

complete -F _hms hms
COMPLETION_EOF
    echo -e "${GREEN}✅ Tab completion installed at $COMPLETION_FILE${NC}"

    BASHRC="$HOME/.bashrc"
    SOURCE_LINE="source $COMPLETION_FILE"
    if [ -f "$BASHRC" ] && grep -qF "$COMPLETION_FILE" "$BASHRC"; then
        echo -e "${GREEN}✅ Completion already configured in ~/.bashrc${NC}"
    else
        echo "$SOURCE_LINE" >> "$BASHRC"
        echo -e "${GREEN}✅ Added source line to ~/.bashrc${NC}"
        echo -e "${YELLOW}ℹ️  Run 'source ~/.bashrc' or open a new terminal to activate it${NC}"
    fi
fi

# Done
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Installation complete${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "Next step:"
echo -e "  ${GREEN}hms start${NC}    # Start the HMS container"
echo ""
echo "Then you can use:"
echo "  hms list          # List available stacks"
echo "  hms <stack> up    # Start a stack"
echo "  hms stop          # Stop HMS"
echo ""
