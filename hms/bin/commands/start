#!/usr/bin/env bash
# HMS Start Command - Bash puro
# Inicia el contenedor HMS y los servicios internos
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
COMPOSE_DIR="$REPO_ROOT/core/hms"
CONTAINER_NAME="hms"
CONFIG_FILE="$REPO_ROOT/config.toml"

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}➜${NC} $*"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }

# Validar Docker disponible
if ! command -v docker >/dev/null 2>&1; then
  log_error "Docker no está instalado"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  log_error "Docker daemon no disponible. Abre Docker Desktop."
  exit 1
fi

# Validar que existe docker-compose.yml
if [ ! -f "$COMPOSE_DIR/docker-compose.yml" ]; then
  log_error "No se encontró docker-compose.yml en $COMPOSE_DIR"
  exit 1
fi

# Validar que existe config.toml
if [ ! -f "$CONFIG_FILE" ]; then
  log_error "No se encontró config.toml"
  log_error "Ejecuta ./install.sh primero para configurar el sistema"
  exit 1
fi

read_global_config() {
  local key="$1"
  local config_file="$CONFIG_FILE"

  if [ ! -f "$config_file" ]; then
    echo ""
    return 1
  fi

  local quote="'"

  awk -v key="$key" -v q="$quote" '
    /^\[global\]/ { in_global=1; next }
    /^\[/ { in_global=0 }
    in_global && $0 ~ "^"key" *= *" {
      sub(/^[^=]*= */, "")
      gsub("^[\""q"]|[\""q"]$", "")
      print
      exit
    }
  ' "$config_file"
}

# Lee el archivo de configuración config.toml para obtener parámetros necesarios
PUID=$(read_global_config "puid" || echo "")
PGID=$(read_global_config "pgid" || echo "")

export PUID PGID

# Verificar si el contenedor ya está corriendo
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  log_info "Iniciando contenedor HMS..."
  # Lo lanza con el usuario actual para evitar problemas de permisos en archivos montados
  (cd "$COMPOSE_DIR" && docker compose up -d --build)

  # Esperar a que el contenedor esté healthy
  log_info "Esperando a que el contenedor esté listo..."
  MAX_RETRIES=30
  RETRY_COUNT=0
  until [ "$RETRY_COUNT" -ge "$MAX_RETRIES" ]; do
    HEALTH_STATUS=$(docker inspect --format='{{.State.Health.Status}}' "$CONTAINER_NAME" 2>/dev/null || echo "unavailable")
    if [ "$HEALTH_STATUS" == "healthy" ]; then
      break
    fi
    if [ "$HEALTH_STATUS" == "unavailable" ]; then
      log_warn "El contenedor no está disponible aún. Esperando..."
    else
      log_info "Estado de salud del contenedor: $HEALTH_STATUS. Esperando..."
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    sleep 2
  done

  # Verificar que el contenedor está corriendo
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    log_error "El contenedor HMS no pudo iniciarse"
    log_error "Revisa los logs con: docker logs $CONTAINER_NAME"
    exit 1
  fi

  log_info "Contenedor HMS iniciado correctamente"
fi

docker exec "$CONTAINER_NAME" python -m hms start "$@"
