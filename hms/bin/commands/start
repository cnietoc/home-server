#!/usr/bin/env bash
# HMS Start Command - starts the HMS container and internal services
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
COMPOSE_DIR="$REPO_ROOT/core/hms"
CONTAINER_NAME="hms"
CONFIG_FILE="$REPO_ROOT/config.toml"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}➜${NC} $*"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }

# Validate Docker is available
if ! command -v docker >/dev/null 2>&1; then
  log_error "Docker is not installed"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  log_error "Docker daemon is not available. Open Docker Desktop."
  exit 1
fi

# Validate docker-compose.yml exists
if [ ! -f "$COMPOSE_DIR/docker-compose.yml" ]; then
  log_error "docker-compose.yml not found in $COMPOSE_DIR"
  exit 1
fi

# Validate config.toml exists
if [ ! -f "$CONFIG_FILE" ]; then
  log_error "config.toml not found"
  log_error "Run hms install first to set up the system"
  exit 1
fi

read_global_config() {
  local key="$1"
  local config_file="$CONFIG_FILE"

  if [ ! -f "$config_file" ]; then
    echo ""
    return 1
  fi

  local quote="'"

  awk -v key="$key" -v q="$quote" '
    /^\[global\]/ { in_global=1; next }
    /^\[/ { in_global=0 }
    in_global && $0 ~ "^"key" *= *" {
      sub(/^[^=]*= */, "")
      gsub("^[\""q"]|[\""q"]$", "")
      print
      exit
    }
  ' "$config_file"
}

# Read config.toml to get required parameters
PUID=$(read_global_config "puid" || echo "")
PGID=$(read_global_config "pgid" || echo "")
DOCKER_GID=$(read_global_config "docker_gid" || echo "")

export PUID PGID DOCKER_GID

# Check if container is already running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  log_info "Starting HMS container..."
  (cd "$COMPOSE_DIR" && docker compose up -d --build)

  # Wait for the container to become healthy
  log_info "Waiting for container to be ready..."
  MAX_RETRIES=30
  RETRY_COUNT=0
  until [ "$RETRY_COUNT" -ge "$MAX_RETRIES" ]; do
    HEALTH_STATUS=$(docker inspect --format='{{.State.Health.Status}}' "$CONTAINER_NAME" 2>/dev/null || echo "unavailable")
    if [ "$HEALTH_STATUS" == "healthy" ]; then
      break
    fi
    if [ "$HEALTH_STATUS" == "unavailable" ]; then
      log_warn "Container not available yet. Waiting..."
    else
      log_info "Container health status: $HEALTH_STATUS. Waiting..."
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    sleep 2
  done

  # Verify the container is running
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    log_error "HMS container could not be started"
    log_error "Check logs with: docker logs $CONTAINER_NAME"
    exit 1
  fi

  log_info "HMS container started successfully"
fi

docker exec "$CONTAINER_NAME" python -m hms start "$@"
