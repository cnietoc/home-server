#!/usr/bin/env bash
# ============================================
# commands/deploy/auto - Deployment automático con detección de cambios
# Despliega stacks automáticamente detectando cambios en configuración
# ============================================

set -euo pipefail

# Obtener rutas del proyecto
COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_ROOT="$(dirname "$COMMAND_DIR")"
PROJECT_ROOT="$(dirname "$COMMANDS_ROOT")"

# Cargar librerías
source "$PROJECT_ROOT/lib/logs.sh"
source "$PROJECT_ROOT/lib/stack.sh"
source "$PROJECT_ROOT/lib/state.sh"
source "$PROJECT_ROOT/lib/docker.sh"
source "$PROJECT_ROOT/lib/deploy.sh"

# ============================================
# FUNCIONES DE AYUDA
# ============================================

show_help() {
    cat << EOF
Uso: hms deploy auto [opciones] [stack1] [stack2] ...

DESCRIPCIÓN:
  Despliega stacks automáticamente detectando cambios en configuración.
  Inicializa infraestructura, regenera .env files y despliega solo lo necesario.

OPCIONES:
  -f, --force               Forzar despliegue sin importar cambios
  -r, --rebuild             Reconstruir imágenes Docker sin caché
  -h, --help                Mostrar esta ayuda

ARGUMENTOS:
  [stack1] [stack2] ...     Stacks específicos a desplegar (opcional)
                            Si no se especifica, despliega stacks con cambios

EJEMPLOS:
  hms deploy auto                    # Detectar y desplegar cambios
  hms deploy auto platform           # Desplegar solo platform si cambió
  hms deploy auto --force            # Forzar despliegue de todos
  hms deploy auto --rebuild media    # Reconstruir imágenes de media

COMPORTAMIENTO:
  - Sin argumentos: despliega solo stacks con cambios detectados
  - Con stacks específicos: despliega solo los especificados (si cambiaron)
  - Con --force: despliega sin importar cambios
  - Regenera .env automáticamente si cambió configuración fuente
  - Verifica salud de contenedores después del deployment
  - Actualiza estado en data/state.yml
  - Respeta stacks deshabilitados en state.yml
EOF
}


# ============================================
# FUNCIÓN PRINCIPAL
# ============================================

main() {
    local force_deploy=false
    local rebuild=false
    local specified_stacks=()

    # Parsear argumentos
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--force)
                force_deploy=true
                shift
                ;;
            -r|--rebuild)
                rebuild=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -*)
                echo "❌ Opción desconocida: $1"
                show_help
                exit 1
                ;;
            *)
                specified_stacks+=("$1")
                shift
                ;;
        esac
    done

    # Banner
    echo "🚀 Home Server - Deployment Automático"
    echo "======================================"
    local last_timestamp
        local last_date

        last_timestamp=$(state::server::get_last_deployment_timestamp)
        last_date=$(state::server::get_last_deployment_date)

        if [[ "$last_timestamp" != "0" && "$last_timestamp" != "null" ]]; then
            local hours_ago=$(( ($(date +%s) - last_timestamp) / 3600 ))
            echo "📅 Último despliegue: hace ${hours_ago}h ($last_date)" >&2
        else
            echo "❓ Nunca se ha desplegado" >&2
        fi
    echo "======================================"

    # Inicializar estado
    state::init || true

    # Inicializar infraestructura
    if ! docker::init_infrastructure; then
        exit 1
    fi
    logs::info "✅ Infraestructura inicializada"

    # Regenerar .env files si es necesario
    deploy::config::regenerate_envs "${specified_stacks[@]}" && logs::info "✅ Archivos .env regenerados"

    # Determinar qué stacks desplegar
    local stacks_to_deploy_raw
    stacks_to_deploy_raw=$(deploy::stacks::determine "$force_deploy" "${specified_stacks[@]}")

    if [[ -z "$stacks_to_deploy_raw" ]]; then
        # Diferenciar entre dos casos
        if [[ ${#specified_stacks[@]} -eq 0 ]]; then
            # Caso 1: No se especificaron stacks y no hay cambios
            logs::info "💡 Usa --force para desplegar todos de todos modos"
            logs::info "💡 O especifica stacks específicos: hms deploy auto platform media"
        else
            # Caso 2: Se especificaron stacks pero no tienen cambios
            logs::info "💡 Usa --force para desplegar sin importar cambios: hms deploy auto --force ${specified_stacks[*]}"
        fi
        exit 0
    fi

    # Convertir a array
    local stacks_to_deploy=()
    while IFS= read -r stack; do
        [[ -z "$stack" ]] && continue
        stacks_to_deploy+=("$stack")
    done <<< "$stacks_to_deploy_raw"

    # Verificar que todos los stacks existen
    for stack in "${stacks_to_deploy[@]}"; do
        if ! docker::stack::exists "$stack"; then
            logs::error "Stack no encontrado: $stack"
            exit 1
        fi
    done

    # Filtrar stacks deshabilitados
    local filter_result
    filter_result=$(deploy::stacks::filter_enabled "${stacks_to_deploy[@]}")

    # Leer línea 1 (habilitados) y línea 2 (deshabilitados)
    local enabled_stacks_str
    local skipped_stacks_str
    enabled_stacks_str=$(echo "$filter_result" | sed -n '1p')
    skipped_stacks_str=$(echo "$filter_result" | sed -n '2p')

    local enabled_stacks=()
    local skipped_stacks=()

    if [[ -n "$enabled_stacks_str" ]]; then
        read -a enabled_stacks <<< "$enabled_stacks_str"
    fi

    if [[ -n "$skipped_stacks_str" ]]; then
        read -a skipped_stacks <<< "$skipped_stacks_str"
    fi

    # Si todos los stacks están deshabilitados, salir
    if [[ ${#enabled_stacks[@]} -eq 0 ]]; then
        if [[ ${#skipped_stacks[@]} -gt 0 ]]; then
            logs::warn "⚠️ Todos los stacks especificados están deshabilitados"
            logs::info "💡 Para habilitar un stack: hms deploy enable <stack>"
        fi
        exit 0
    fi

    # Mostrar información
    if [[ ${#skipped_stacks[@]} -gt 0 ]]; then
        logs::info "📋 Stacks a desplegar: ${enabled_stacks[*]}"
        logs::info "⏭️ Stacks omitidos (deshabilitados): ${skipped_stacks[*]}"
        echo ""
    fi

    # Preguntar confirmación si se va a rebuildar
    if [[ "$rebuild" == "true" ]]; then
        logs::warn "⚠️ Se van a RECONSTRUIR las imágenes Docker sin caché de: ${enabled_stacks[*]}"
        logs::warn "Esto puede tardar más tiempo."
        read -p "¿Continuar? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            logs::info "❌ Operación cancelada"
            exit 0
        fi
    fi

    # Desplegar stacks
    local result
    result=$(deploy::stacks::deploy_multiple "$rebuild" "${enabled_stacks[@]}")

    local success="${result%% *}"
    local rest="${result#* }"
    local total="${rest%% *}"
    local failed="${rest#* }"

    # Remover números del inicio de failed
    failed="${failed#* }"

    # Resumen final
    echo "📊 RESUMEN DEL DESPLIEGUE"
    echo "=========================="
    logs::info "✅ Exitosos: $success/$total stacks"

    if [[ -n "$failed" && "$failed" != "$total" ]]; then
        logs::error "❌ Con problemas: $failed"
        logs::error "💡 Para diagnosticar problemas:"
        logs::error "   hms show logs <stack>"
    fi
    echo "=========================="
    echo ""
    if [[ "$success" == "$total" ]]; then
        logs::info "🎉 Despliegue completado exitosamente"

        # Mostrar URLs de acceso si todo está bien
        if [[ -x "${COMMANDS_ROOT}/show/stacks" ]]; then
            "${COMMANDS_ROOT}/show/stacks" "${enabled_stacks[@]}" || true
        fi
    else
        logs::error "⚠️ Despliegue completado con errores"
        exit 1
    fi
}

main "$@"
