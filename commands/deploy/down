#!/usr/bin/env bash
# ============================================
# commands/deploy/down — Parar stacks
# ============================================

set -euo pipefail

# Obtener rutas del proyecto
COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_ROOT="$(dirname "$COMMAND_DIR")"
PROJECT_ROOT="$(dirname "$COMMANDS_ROOT")"

# Cargar librerías
source "$PROJECT_ROOT/lib/logs.sh"
source "$PROJECT_ROOT/lib/stack.sh"
source "$PROJECT_ROOT/lib/state.sh"
source "$PROJECT_ROOT/lib/docker.sh"

# ============================================
# FUNCIONES DE AYUDA
# ============================================

show_help() {
    cat << EOF
Uso: hms deploy down [opciones] [stack1] [stack2] ...

DESCRIPCIÓN:
  Detiene stacks y opcionalmente realiza limpieza de recursos Docker.

OPCIONES DE LIMPIEZA DEL STACK:
  -v, --volumes             Eliminar volúmenes del stack
  -i, --images              Eliminar imágenes del stack
  -n, --networks            Eliminar redes del stack
  -c, --clean               Limpieza completa del stack (equivale a -v -i -n)

OPCIONES DE LIMPIEZA DEL SISTEMA:
  -V, --all-volumes         Eliminar TODOS los volúmenes del sistema
  -I, --all-images          Eliminar TODAS las imágenes del sistema
  -N, --all-networks        Eliminar TODAS las redes del sistema
  -C, --system-clean        Limpieza TOTAL del sistema (equivale a clean-deploy.sh)

OPCIONES DE COMPORTAMIENTO:
  -f, --force               No pedir confirmación
  -h, --help                Mostrar esta ayuda

ARGUMENTOS:
  [stack1] [stack2] ...     Stacks a procesar (opcional)
                            Sin argumentos: aplica a TODOS los stacks

EJEMPLOS:
  # Limpieza por stack:
  hms deploy down                         # Detener TODOS los stacks
  hms deploy down platform                # Solo detener platform
  hms deploy down -v platform             # Detener + eliminar volúmenes de platform
  hms deploy down -c platform             # Limpieza completa de platform
  hms deploy down -vi platform media      # Detener + volúmenes + imágenes de platform y media

  # Limpieza del sistema:
  hms deploy down -V                      # Eliminar TODOS los volúmenes del sistema
  hms deploy down -I                      # Eliminar TODAS las imágenes del sistema
  hms deploy down -C                      # Limpieza TOTAL del sistema
  hms deploy down -f -C                   # Limpieza total sin confirmación

NOTA:
  - Sin argumentos: detiene TODOS los stacks (sin eliminar recursos)
  - Las opciones mayúsculas (-V, -I, -N, -C) NO requieren especificar stacks
  - Las opciones minúsculas (-v, -i, -n, -c) pueden aplicarse a stacks específicos o todos
  - Operaciones destructivas requieren confirmación (excepto con -f)
EOF
}

# ============================================
# FUNCIONES
# ============================================

# Detener un stack específico
command::deploy::down() {
    local stack="$1"
    local remove_volumes="${2:-false}"

    local stack_dir="$PROJECT_ROOT/docker/$stack"

    if [[ ! -d "$stack_dir" ]]; then
        logs::error "❌ Stack no encontrado: $stack"
        return 1
    fi

    logs::info "⏬ Deteniendo stack: $stack"

    # Preparar comando
    local down_cmd="docker compose down"
    if [[ "$remove_volumes" == "true" ]]; then
        down_cmd="$down_cmd --volumes"
        logs::warn "   ⚠️ Eliminando volúmenes nombrados"
    fi

    # Ejecutar docker compose down
    if (cd "$stack_dir" && eval "$down_cmd" 2>&1); then
        logs::info "   ✅ Stack detenido: $stack"
        return 0
    else
        logs::error "   ❌ Error al detener stack: $stack"
        return 1
    fi
}

# Eliminar imágenes de un stack
command::deploy::clean_stack_images() {
    local stack="$1"
    local stack_dir="$PROJECT_ROOT/docker/$stack"

    logs::info "🗑️  Eliminando imágenes del stack: $stack"

    # Obtener imágenes del stack usando docker compose config
    local images
    if (cd "$stack_dir" && docker compose config --images 2>/dev/null); then
        images=$(cd "$stack_dir" && docker compose config --images 2>/dev/null)

        if [[ -n "$images" ]]; then
            while IFS= read -r image; do
                [[ -z "$image" ]] && continue
                if docker rmi "$image" 2>/dev/null; then
                    logs::info "   ✅ Eliminada: $image"
                else
                    logs::warn "   ⚠️ No se pudo eliminar: $image (puede estar en uso)"
                fi
            done <<< "$images"
        else
            logs::info "   ℹ️  No hay imágenes para eliminar"
        fi
        return 0
    else
        logs::error "   ❌ Error al obtener imágenes del stack"
        return 1
    fi
}

# Eliminar redes de un stack
command::deploy::clean_stack_networks() {
    local stack="$1"

    logs::info "🗑️  Eliminando redes del stack: $stack"

    # Obtener redes del stack (buscar por prefijo del stack)
    local networks
    networks=$(docker network ls --filter "name=${stack}" --format "{{.Name}}" 2>/dev/null)

    if [[ -n "$networks" ]]; then
        while IFS= read -r network; do
            [[ -z "$network" ]] && continue
            # No eliminar redes por defecto
            if [[ "$network" != "bridge" && "$network" != "host" && "$network" != "none" ]]; then
                if docker network rm "$network" 2>/dev/null; then
                    logs::info "   ✅ Eliminada: $network"
                else
                    logs::warn "   ⚠️ No se pudo eliminar: $network (puede estar en uso)"
                fi
            fi
        done <<< "$networks"
    else
        logs::info "   ℹ️  No hay redes personalizadas para eliminar"
    fi
}

# Limpieza completa de un stack
command::deploy::clean_stack_complete() {
    local stack="$1"

    logs::info "🧹 Limpieza completa del stack: $stack"

    # Down con volúmenes
    command::deploy::down "$stack" "true"

    # Limpiar imágenes
    command::deploy::clean_stack_images "$stack"

    # Limpiar redes
    command::deploy::clean_stack_networks "$stack"

    logs::info "   ✅ Limpieza completa de $stack finalizada"
}

# Eliminar TODOS los volúmenes del sistema
command::deploy::clean_all_volumes() {
    logs::info "🗑️  Eliminando TODOS los volúmenes del sistema..."

    local volumes
    volumes=$(docker volume ls -q)

    if [[ -n "$volumes" ]]; then
        local count=0
        while IFS= read -r volume; do
            [[ -z "$volume" ]] && continue
            if docker volume rm "$volume" 2>/dev/null; then
                count=$((count + 1))
            fi
        done <<< "$volumes"
        logs::info "   ✅ Eliminados: $count volúmenes"
    else
        logs::info "   ℹ️  No hay volúmenes para eliminar"
    fi
}

# Eliminar TODAS las imágenes del sistema
command::deploy::clean_all_images() {
    logs::info "🗑️  Eliminando TODAS las imágenes del sistema..."

    # Usar docker image prune -a para eliminar todas las imágenes no usadas
    if docker image prune -a -f; then
        logs::info "   ✅ Imágenes eliminadas"
    else
        logs::error "   ❌ Error al eliminar imágenes"
        return 1
    fi
}

# Eliminar TODAS las redes personalizadas
command::deploy::clean_all_networks() {
    logs::info "🗑️  Eliminando TODAS las redes personalizadas..."

    # Usar docker network prune para eliminar redes no usadas
    if docker network prune -f; then
        logs::info "   ✅ Redes eliminadas"
    else
        logs::error "   ❌ Error al eliminar redes"
        return 1
    fi
}

# Limpieza TOTAL del sistema (equivale a clean-deploy.sh)
command::deploy::clean_system_complete() {
    logs::info "🧹 LIMPIEZA TOTAL DEL SISTEMA"
    echo ""

    # Detener todos los contenedores
    logs::info "⏬ Deteniendo todos los contenedores..."
    local containers
    containers=$(docker ps -q)
    if [[ -n "$containers" ]]; then
        docker stop $containers 2>/dev/null || true
        docker rm $containers 2>/dev/null || true
        logs::info "   ✅ Contenedores detenidos y eliminados"
    else
        logs::info "   ℹ️  No hay contenedores corriendo"
    fi
    echo ""

    # Eliminar todos los volúmenes
    command::deploy::clean_all_volumes
    echo ""

    # Eliminar todas las imágenes
    command::deploy::clean_all_images
    echo ""

    # Eliminar todas las redes
    command::deploy::clean_all_networks
    echo ""

    # Limpieza adicional del sistema
    logs::info "🧹 Limpieza adicional del sistema..."
    docker system prune -a -f --volumes 2>/dev/null || true
    logs::info "   ✅ Limpieza del sistema completada"

    echo ""
    logs::info "🎉 Limpieza TOTAL del sistema finalizada"
}

# ============================================
# FUNCIÓN PRINCIPAL
# ============================================

main() {
    # Opciones de limpieza por stack
    local remove_volumes=false
    local remove_images=false
    local remove_networks=false
    local clean_stack=false

    # Opciones de limpieza del sistema
    local all_volumes=false
    local all_images=false
    local all_networks=false
    local system_clean=false

    # Opciones de comportamiento
    local force=false
    local stacks=()

    # Parsear argumentos
    while [[ $# -gt 0 ]]; do
        case $1 in
            # Opciones de limpieza del stack (minúsculas)
            -v|--volumes)
                remove_volumes=true
                shift
                ;;
            -i|--images)
                remove_images=true
                shift
                ;;
            -n|--networks)
                remove_networks=true
                shift
                ;;
            -c|--clean)
                clean_stack=true
                shift
                ;;
            # Opciones de limpieza del sistema (mayúsculas)
            -V|--all-volumes)
                all_volumes=true
                shift
                ;;
            -I|--all-images)
                all_images=true
                shift
                ;;
            -N|--all-networks)
                all_networks=true
                shift
                ;;
            -C|--system-clean)
                system_clean=true
                shift
                ;;
            # Opciones de comportamiento
            -f|--force)
                force=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -*)
                logs::error "Opción desconocida: $1"
                show_help
                exit 1
                ;;
            *)
                stacks+=("$1")
                shift
                ;;
        esac
    done

    # Determinar si es operación de sistema o por stack
    local is_system_operation=false
    if [[ "$all_volumes" == "true" || "$all_images" == "true" || "$all_networks" == "true" || "$system_clean" == "true" ]]; then
        is_system_operation=true
    fi

    # Si no se especificaron stacks y no es operación de sistema, usar todos los stacks
    if [[ "$is_system_operation" == "false" && ${#stacks[@]} -eq 0 ]]; then
        logs::info "📋 No se especificaron stacks, aplicando a todos..."

        local all_stacks
        all_stacks=$(stack::list)

        while IFS= read -r stack; do
            [[ -z "$stack" ]] && continue
            stacks+=("$stack")
        done <<< "$all_stacks"

        if [[ ${#stacks[@]} -eq 0 ]]; then
            logs::error "❌ No hay stacks disponibles"
            exit 1
        fi

        logs::info "   Stacks encontrados: ${stacks[*]}"
        echo ""
    fi

    # Si es limpieza completa del stack, activar todas las opciones
    if [[ "$clean_stack" == "true" ]]; then
        remove_volumes=true
        remove_images=true
        remove_networks=true
    fi

    # Banner
    echo "🛑 Home Server - Deploy Down"
    echo "======================================"
    echo ""

    # ============================================
    # OPERACIONES DE SISTEMA
    # ============================================

    if [[ "$system_clean" == "true" ]]; then
        # Limpieza TOTAL del sistema
        logs::warn "⚠️  ADVERTENCIA: LIMPIEZA TOTAL DEL SISTEMA"
        logs::warn "    Se eliminarán:"
        logs::warn "    • TODOS los contenedores (detenidos y corriendo)"
        logs::warn "    • TODOS los volúmenes"
        logs::warn "    • TODAS las imágenes"
        logs::warn "    • TODAS las redes personalizadas"
        logs::warn ""
        logs::warn "    Esta acción es IRREVERSIBLE"
        echo ""

        if [[ "$force" != "true" ]]; then
            read -p "¿Estás COMPLETAMENTE seguro? Escribe 'ELIMINAR TODO' para continuar: " -r
            echo
            if [[ "$REPLY" != "ELIMINAR TODO" ]]; then
                logs::info "❌ Operación cancelada"
                exit 0
            fi
            echo ""
        fi

        command::deploy::clean_system_complete
        exit 0

    elif [[ "$all_volumes" == "true" || "$all_images" == "true" || "$all_networks" == "true" ]]; then
        # Limpieza selectiva del sistema
        logs::warn "⚠️  ADVERTENCIA: Limpieza del sistema"

        if [[ "$all_volumes" == "true" ]]; then
            logs::warn "    • Se eliminarán TODOS los volúmenes del sistema"
        fi
        if [[ "$all_images" == "true" ]]; then
            logs::warn "    • Se eliminarán TODAS las imágenes del sistema"
        fi
        if [[ "$all_networks" == "true" ]]; then
            logs::warn "    • Se eliminarán TODAS las redes personalizadas"
        fi

        echo ""

        if [[ "$force" != "true" ]]; then
            read -p "¿Continuar? Escribe 'SI' para confirmar: " -r
            echo
            if [[ "$REPLY" != "SI" ]]; then
                logs::info "❌ Operación cancelada"
                exit 0
            fi
            echo ""
        fi

        # Ejecutar limpieza según opciones
        if [[ "$all_volumes" == "true" ]]; then
            command::deploy::clean_all_volumes
            echo ""
        fi

        if [[ "$all_images" == "true" ]]; then
            command::deploy::clean_all_images
            echo ""
        fi

        if [[ "$all_networks" == "true" ]]; then
            command::deploy::clean_all_networks
            echo ""
        fi

        logs::info "🎉 Limpieza del sistema completada"
        exit 0
    fi

    # ============================================
    # OPERACIONES POR STACK
    # ============================================

    # Verificar que todos los stacks existen
    for stack in "${stacks[@]}"; do
        if ! docker::stack::exists "$stack"; then
            logs::error "Stack no encontrado: $stack"
            logs::info "💡 Stacks disponibles: $(stack::list | tr '\n' ' ')"
            exit 1
        fi
    done

    # Advertencia si se van a hacer operaciones destructivas
    local has_destructive_ops=false
    local destructive_msg=""

    if [[ "$remove_volumes" == "true" ]]; then
        has_destructive_ops=true
        destructive_msg+="    • Volúmenes (datos permanentes)\n"
    fi
    if [[ "$remove_images" == "true" ]]; then
        has_destructive_ops=true
        destructive_msg+="    • Imágenes Docker\n"
    fi
    if [[ "$remove_networks" == "true" ]]; then
        has_destructive_ops=true
        destructive_msg+="    • Redes personalizadas\n"
    fi

    if [[ "$has_destructive_ops" == "true" && "$force" != "true" ]]; then
        echo ""
        logs::warn "⚠️  ADVERTENCIA: Se eliminarán los siguientes recursos de: ${stacks[*]}"
        echo -e "$destructive_msg"
        logs::warn "    Esta acción NO se puede deshacer."
        echo ""
        read -p "¿Estás seguro? Escribe 'SI' para continuar: " -r
        echo
        if [[ "$REPLY" != "SI" ]]; then
            logs::info "❌ Operación cancelada"
            exit 0
        fi
        echo ""
    fi

    # Procesar cada stack
    local success=0
    local total=${#stacks[@]}
    local failed_stacks=()

    for stack in "${stacks[@]}"; do
        if [[ "$clean_stack" == "true" ]]; then
            # Limpieza completa del stack
            if command::deploy::clean_stack_complete "$stack"; then
                success=$((success + 1))
            else
                failed_stacks+=("$stack")
            fi
        else
            # Operaciones individuales
            local stack_success=true

            # Down (siempre se ejecuta)
            if ! command::deploy::down "$stack" "$remove_volumes"; then
                stack_success=false
            fi

            # Limpiar imágenes si se pidió
            if [[ "$remove_images" == "true" && "$stack_success" == "true" ]]; then
                if ! command::deploy::clean_stack_images "$stack"; then
                    stack_success=false
                fi
            fi

            # Limpiar redes si se pidió
            if [[ "$remove_networks" == "true" && "$stack_success" == "true" ]]; then
                if ! command::deploy::clean_stack_networks "$stack"; then
                    stack_success=false
                fi
            fi

            if [[ "$stack_success" == "true" ]]; then
                success=$((success + 1))
            else
                failed_stacks+=("$stack")
            fi
        fi
        echo ""
    done

    # Resumen final
    echo "📊 RESUMEN"
    echo "=========================="
    logs::info "✅ Procesados exitosamente: $success/$total stacks"

    if [[ ${#failed_stacks[@]} -gt 0 ]]; then
        logs::error "❌ Con errores: ${failed_stacks[*]}"
        echo "=========================="
        echo ""
        exit 1
    fi

    echo "=========================="
    echo ""
    logs::info "🎉 Operación completada exitosamente"

    # Mensaje informativo según lo que se hizo
    if [[ "$clean_stack" == "true" || "$remove_volumes" == "true" || "$remove_images" == "true" || "$remove_networks" == "true" ]]; then
        logs::info "💡 Recursos eliminados según las opciones especificadas"
    else
        logs::info "💡 Los datos se mantienen en los volúmenes"
        logs::info "💡 Para limpieza completa: hms deploy down -c <stack>"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
