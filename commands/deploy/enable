#!/usr/bin/env bash
# ============================================
# commands/deploy/enable — Habilitar stack(s) y desplegar opcionalmente
# ============================================
set -euo pipefail

COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_ROOT="$(dirname "$COMMAND_DIR")"
PROJECT_ROOT="$(dirname "$COMMANDS_ROOT")"

# Librerías
source "$PROJECT_ROOT/lib/logs.sh"
source "$PROJECT_ROOT/lib/stack.sh"
source "$PROJECT_ROOT/lib/state.sh"
source "$PROJECT_ROOT/lib/docker.sh"
source "$PROJECT_ROOT/lib/deploy.sh"

show_help() {
  cat <<EOF
Uso: hms deploy enable [opciones] <stack1> [stack2] ...

Descripción:
  Habilita uno o más stacks en el archivo de estado y opcionalmente los despliega.

Opciones:
  --no-up            Solo habilita, NO despliega
  -b, --rebuild      Reconstruir imágenes sin caché al desplegar
  -f, --force        No fallar si ya estaba habilitado
  -h, --help         Mostrar esta ayuda

Comportamiento por defecto:
  - Habilita los stacks indicados
  - Si el stack estaba deshabilitado o nunca desplegado, se intentará desplegar
  - Usa deploy inteligente (como 'hms deploy up')

Ejemplos:
  hms deploy enable platform
  hms deploy enable platform media
  hms deploy enable --no-up media
  hms deploy enable --rebuild platform
EOF
}

main() {
  local do_up=true
  local rebuild=false
  local force=false
  local stacks=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-up)
        do_up=false; shift ;;
      -b|--rebuild)
        rebuild=true; shift ;;
      -f|--force)
        force=true; shift ;;
      -h|--help)
        show_help; exit 0 ;;
      -*)
        logs::error "Opción desconocida: $1"
        show_help; exit 1 ;;
      *)
        stacks+=("$1"); shift ;;
    esac
  done

  if [[ ${#stacks[@]} -eq 0 ]]; then
    logs::error "❌ Debes especificar al menos un stack"
    show_help
    exit 1
  fi

  echo "✅ Habilitar stacks"
  echo "============================"

  state::init || true

  # Validar stacks
  for stack in "${stacks[@]}"; do
    if ! docker::stack::exists "$stack"; then
      logs::error "Stack no encontrado: $stack"
      logs::info "Stacks disponibles: $(stack::list | tr '\n' ' ')"
      exit 1
    fi
  done

  local to_deploy=()
  for stack in "${stacks[@]}"; do
    if state::stack::is_enabled "$stack"; then
      if [[ "$force" == "true" ]]; then
        logs::warn "⚠️ Ya estaba habilitado: $stack (continuando)"
        # Decidir si desplegar: lo añadimos si no está corriendo
        if ! docker::stack::is_running "$stack"; then
          to_deploy+=("$stack")
        fi
      else
        logs::info "➡️  Ya habilitado: $stack"
        # Desplegar si no corre
        if ! docker::stack::is_running "$stack"; then
          to_deploy+=("$stack")
        fi
      fi
    else
      # Habilitar
      state::stack::enable "$stack"
      to_deploy+=("$stack")
    fi
  done

  if [[ "$do_up" != "true" ]]; then
    logs::info "🚫 --no-up especificado: no se desplegarán stacks"
    exit 0
  fi

  if [[ ${#to_deploy[@]} -eq 0 ]]; then
    logs::info "✅ No hay stacks que necesiten desplegarse"
    exit 0
  fi

  echo ""
  logs::info "🚀 Desplegando stacks habilitados: ${to_deploy[*]}"

  # Reutilizar lógica de 'up': determinamos cuáles están detenidos o con cambios
  local stopped=()
  local changed=()
  local final=()

  for stack in "${to_deploy[@]}"; do
    local needs=false
    if ! docker::stack::is_running "$stack"; then
      stopped+=("$stack"); needs=true
    elif deploy::stack::has_changed "$stack"; then
      changed+=("$stack"); needs=true
    fi
    if [[ "$needs" == "true" ]]; then
      final+=("$stack")
    fi
  done

  if [[ ${#final[@]} -eq 0 ]]; then
    logs::info "ℹ️ Todos los stacks ya están corriendo y sin cambios"
    exit 0
  fi

  if [[ "$rebuild" == "true" ]]; then
    logs::warn "⚠️ Se reconstruirán imágenes (sin caché) de: ${final[*]}"
    read -p "¿Continuar? (y/N): " -n 1 -r; echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      logs::info "Operación cancelada"
      exit 0
    fi
  fi

  # Ejecutar deployment múltiple
  local result
  result=$(deploy::stacks::deploy_multiple "$rebuild" "${final[@]}")
  local success="${result%% *}"; local rest="${result#* }"; local total="${rest%% *}"; local failed="${rest#* }"; failed="${failed#* }"

  echo ""; echo "📊 RESUMEN"; echo "============================"
  logs::info "✅ Exitosos: $success/$total"
  if [[ -n "$failed" && "$failed" != "$total" ]]; then
    logs::error "❌ Con problemas: $failed"
  fi
  echo "============================"

  if [[ "$success" == "$total" ]]; then
    logs::info "🎉 Habilitación y despliegue completados"
  else
    exit 1
  fi
}

main "$@"
