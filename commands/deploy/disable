#!/usr/bin/env bash
# ============================================
# commands/deploy/disable — Deshabilitar stack(s) y detener opcionalmente
# ============================================
set -euo pipefail

COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_ROOT="$(dirname "$COMMAND_DIR")"
PROJECT_ROOT="$(dirname "$COMMANDS_ROOT")"

# Librerías
source "$PROJECT_ROOT/lib/logs.sh"
source "$PROJECT_ROOT/lib/stack.sh"
source "$PROJECT_ROOT/lib/state.sh"
source "$PROJECT_ROOT/lib/docker.sh"
# Reutilizar funciones de down
source "$COMMAND_DIR/down"

show_help() {
  cat <<EOF
Uso: hms deploy disable [opciones] <stack1> [stack2] ...

Descripción:
  Deshabilita uno o más stacks en el archivo de estado y detiene sus contenedores.

Opciones:
  --no-down          Solo deshabilita, NO detiene contenedores
  -v, --volumes      Eliminar volúmenes del stack al detener
  -i, --images       Eliminar imágenes del stack (tras detener)
  -n, --networks     Eliminar redes del stack (tras detener)
  -c, --clean        Limpieza completa del stack (equivale a -v -i -n)
  -r, --reason <txt> Motivo de la deshabilitación (se guarda en estado)
  -f, --force        No fallar si ya estaba deshabilitado
  -h, --help         Mostrar esta ayuda

Comportamiento por defecto:
  - Deshabilita el stack
  - Detiene contenedores (docker compose down) sin eliminar volúmenes

Ejemplos:
  hms deploy disable platform
  hms deploy disable platform media
  hms deploy disable --no-down media
  hms deploy disable -v platform
  hms deploy disable -c platform media
  hms deploy disable -r "Mantenimiento" platform
EOF
}

main() {
  local do_down=true
  local remove_volumes=false
  local remove_images=false
  local remove_networks=false
  local clean_stack=false
  local force=false
  local reason=""
  local stacks=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-down)
        do_down=false; shift ;;
      -v|--volumes)
        remove_volumes=true; shift ;;
      -i|--images)
        remove_images=true; shift ;;
      -n|--networks)
        remove_networks=true; shift ;;
      -c|--clean)
        clean_stack=true; shift ;;
      -r|--reason)
        shift; reason="${1:-}"; [[ -z "$reason" ]] && { logs::error "Falta valor para --reason"; exit 1; }; shift ;;
      -f|--force)
        force=true; shift ;;
      -h|--help)
        show_help; exit 0 ;;
      -*)
        logs::error "Opción desconocida: $1"; show_help; exit 1 ;;
      *)
        stacks+=("$1"); shift ;;
    esac
  done

  if [[ ${#stacks[@]} -eq 0 ]]; then
    logs::error "❌ Debes especificar al menos un stack"
    show_help
    exit 1
  fi

  if [[ "$clean_stack" == "true" ]]; then
    remove_volumes=true
    remove_images=true
    remove_networks=true
  fi

  echo "🛑 Deshabilitar stacks"
  echo "============================"

  state::init || true

  # Validar stacks
  for stack in "${stacks[@]}"; do
    if ! docker::stack::exists "$stack"; then
      logs::error "Stack no encontrado: $stack"
      logs::info "Stacks disponibles: $(stack::list | tr '\n' ' ')"
      exit 1
    fi
  done

  local to_down=()

  for stack in "${stacks[@]}"; do
    if state::stack::is_enabled "$stack"; then
      # Deshabilitar
      state::stack::disable "$stack" "${reason:-No especificado}"
      to_down+=("$stack")
    else
      if [[ "$force" == "true" ]]; then
        logs::warn "⚠️ Ya estaba deshabilitado: $stack (continuando)"
        to_down+=("$stack")
      else
        logs::info "➡️  Ya deshabilitado: $stack"
        to_down+=("$stack")
      fi
    fi
  done

  if [[ "$do_down" != "true" ]]; then
    logs::info "🚫 --no-down especificado: no se detendrán contenedores"
    exit 0
  fi

  if [[ ${#to_down[@]} -eq 0 ]]; then
    logs::info "✅ Nada que detener"
    exit 0
  fi

  echo ""
  logs::info "⏬ Deteniendo stacks deshabilitados: ${to_down[*]}"

  # Confirmación si se van a eliminar recursos destructivos
  local destructive=false
  if [[ "$remove_volumes" == "true" || "$remove_images" == "true" || "$remove_networks" == "true" ]]; then
    destructive=true
  fi

  if [[ "$destructive" == "true" ]]; then
    logs::warn "⚠️ Se eliminarán recursos de los stacks: ${to_down[*]}"
    [[ "$remove_volumes" == "true" ]] && logs::warn "   • Volúmenes"
    [[ "$remove_images" == "true" ]] && logs::warn "   • Imágenes"
    [[ "$remove_networks" == "true" ]] && logs::warn "   • Redes"
    read -p "¿Confirmar? (escribe SI): " -r; echo
    if [[ "$REPLY" != "SI" ]]; then
      logs::info "Operación cancelada"
      exit 0
    fi
  fi

  local success=0
  local failed=()
  local total=${#to_down[@]}

  for stack in "${to_down[@]}"; do
    local ok=true

    # Down (usa función namespace del script down)
    if ! command::deploy::down "$stack" "$remove_volumes"; then
      ok=false
    fi

    if [[ "$ok" == "true" && "$remove_images" == "true" ]]; then
      command::deploy::clean_stack_images "$stack" || ok=false
    fi

    if [[ "$ok" == "true" && "$remove_networks" == "true" ]]; then
      command::deploy::clean_stack_networks "$stack" || ok=false
    fi

    if [[ "$ok" == "true" ]]; then
      success=$((success + 1))
    else
      failed+=("$stack")
    fi
    echo ""
  done

  echo "📊 RESUMEN"
  echo "============================"
  logs::info "✅ Procesados: $success/$total"
  if [[ ${#failed[@]} -gt 0 ]]; then
    logs::error "❌ Fallaron: ${failed[*]}"
  fi
  echo "============================"

  if [[ $success -eq $total ]]; then
    logs::info "🎉 Deshabilitación completada"
  else
    exit 1
  fi
}

main "$@"
