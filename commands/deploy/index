#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../" && pwd)"
COMMANDS_DIR="$ROOT_DIR/commands/deploy"
source "$ROOT_DIR/lib/logs.sh"

show_deploy_help() {
    cat << 'EOF'
🚀 HMS Deploy - Gestión de deployments

Uso: hms deploy <comando> [opciones]

COMANDOS:
  up [stack1] [stack2] ...       Iniciar/deploy de uno o varios stacks
  down [stack1] [stack2] ...     Parar uno o varios stacks
  enable [stack1] [stack2] ...   Habilitar un stack
  disable [stack1] [stack2] ...  Deshabilitar un stack

EJEMPLOS:
  hms deploy up
  hms deploy down media
  hms deploy enable media

Para más información sobre un subcomando:
  hms deploy <comando> --help
EOF
}

main() {
    if [[ ${1-} == "--help" || ${1-} == "-h" ]]; then
        show_deploy_help
        exit 0
    fi

    if [[ $# -eq 0 ]]; then
        # Sin subcomando, muestra ayuda
        show_deploy_help
        exit 0
    fi

    local subcmd="$1"
    shift

    local subcmd_path="$COMMANDS_DIR/$subcmd"
    if [[ ! -f "$subcmd_path" || ! -x "$subcmd_path" ]]; then
        logs::error "Subcomando de deploy no válido: $subcmd"
        echo ""
        show_deploy_help
        exit 1
    fi

    logs::debug "Delegando deploy->$subcmd"
    export HMS_INVOKED=true
    exec "$subcmd_path" "$@"
}

main "$@"

