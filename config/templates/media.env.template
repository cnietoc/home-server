# Configuración específica para el stack de medios

# Credenciales de Transmission (cambiar por seguridad)
TRANSMISSION_USER=admin
# Generar password seguro: echo -n "tu_password" | sha256sum
TRANSMISSION_PASS=admin

# Hardware acceleration (ajustar según tu hardware)
# Para Intel Quick Sync Video
ENABLE_INTEL_QSV=false
# Para NVIDIA NVENC (requiere nvidia-container-toolkit)
ENABLE_NVIDIA=false
# Para AMD VAAPI
ENABLE_VAAPI=false

# Configuración de transcodificación Tdarr
# Codec preferido: h264, h265, av1
PREFERRED_CODEC=h264
# Resolución objetivo: 720p, 1080p, 4k
TARGET_RESOLUTION=1080p
# Bitrate objetivo (ajustar según calidad deseada)
TARGET_BITRATE=5000k

