# Configuración de ArchiSteamFarm para farmeo automático de cromos Steam

# ===== CREDENCIALES STEAM (REQUERIDAS) =====
# Usuario y contraseña de la cuenta Steam
STEAM_USERNAME=tu_usuario_steam
STEAM_PASSWORD=tu_contraseña_steam

# ===== CONFIGURACIÓN DE FARMEO =====
# Farmear cromos en modo offline (sin necesidad de jugar)
# true = farmea 24/7 sin jugar
# false = no farmea en modo offline
ASF_FARM_OFFLINE=false
