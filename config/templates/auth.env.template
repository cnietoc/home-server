# Secretos de Authelia para autenticación
# Genera estas claves con: openssl rand -hex 32

AUTHELIA_JWT_SECRET=your-jwt-secret-key-here-32-chars-min
AUTHELIA_SESSION_SECRET=your-session-secret-key-here-32-chars-min
AUTHELIA_STORAGE_ENCRYPTION_KEY=your-storage-encryption-key-here-32-chars-min

# Configuración del usuario administrador
# Genera el hash con: ./scripts/generate-auth-password.sh
# IMPORTANTE: Escapa los caracteres $ del hash como \$$ (ej: \$$argon2id\$$v=19...)
AUTHELIA_ADMIN_PASSWORD_HASH=your-password-hash-here
AUTHELIA_ADMIN_EMAIL=admin@tu-dominio.com

