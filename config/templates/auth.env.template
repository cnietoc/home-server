# Secretos de Authelia para autenticación
# Genera estas claves con: openssl rand -hex 32

AUTHELIA_JWT_SECRET=your-jwt-secret-key-here-32-chars-min
AUTHELIA_SESSION_SECRET=your-session-secret-key-here-32-chars-min
AUTHELIA_STORAGE_ENCRYPTION_KEY=your-storage-encryption-key-here-32-chars-min

# Google OAuth2 (opcional - para login con Google)
# Obtén estas credenciales en: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Configuración del usuario administrador (fallback si no usas Google OAuth)
# Genera el hash con: ./scripts/generate-auth-password.sh
AUTHELIA_ADMIN_PASSWORD_HASH='your-password-hash-here'
AUTHELIA_ADMIN_EMAIL=admin@tu-dominio.com

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# --- Secrets (genera con: openssl rand -hex 32) ---
AUTHELIA_JWT_SECRET=9f1aa3a6c63d9b8be617ba6b3cb4b12f
AUTHELIA_STORAGE_ENCRYPTION_KEY=0b24e5e75a2b4f92a087ff2d10e44b16
AUTHELIA_SESSION_SECRET=2aa81cd15b48d97a3e540ea4c0f4b21a

# --- Access Control ---
AUTHELIA_ACCESS_CONTROL_RULES=|
  - domain: "*.example.com"
    policy: one_factor
    subject:
      - "user:allowed@example.com"
      - "user:someone.else@gmail.com"