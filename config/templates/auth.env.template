# Secretos de Authelia para autenticación
# Genera estas claves con: openssl rand -hex 32

AUTHELIA_JWT_SECRET=your-jwt-secret-key-here-32-chars-min
AUTHELIA_SESSION_SECRET=your-session-secret-key-here-32-chars-min
AUTHELIA_STORAGE_ENCRYPTION_KEY=your-storage-encryption-key-here-32-chars-min

# Base de datos de usuarios en formato YAML inline
# Genera el hash con: docker run --rm authelia/authelia:latest authelia hash-password 'tu-contraseña'
# IMPORTANTE: Reemplaza 'your-password-hash-here' con el hash real generado
AUTHELIA_USERS_DATABASE="users:
  admin:
    displayname: Administrator
    password: your-password-hash-here
    email: admin@tu-dominio.com
    groups:
      - admins"

