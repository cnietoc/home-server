# Configuración de Watchtower para actualizaciones automáticas de imágenes Docker

# Programación de actualizaciones
# Formato cron: "segundo minuto hora día mes día_semana"
# Ejemplo: "0 0 4 * * *" = todos los días a las 4:00 AM
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Intervalo de polling (alternativa al schedule, no usar ambos)
# Formato: 30s, 5m, 1h, etc.
# WATCHTOWER_POLL_INTERVAL=24h

# Configuración de notificaciones
# Opciones: email, slack, discord, telegram, webhook
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_NOTIFICATIONS_LEVEL=info

# Nivel de logging
# Opciones: panic, fatal, error, warn, info, debug, trace
WATCHTOWER_LOG_LEVEL=info
