# Configuración de OneDrive para HMS
# =======================================
# Rellena estos campos con los datos de tu app registrada en Azure AD
# Ver: https://learn.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

# ========== OBLIGATORIO ==========

# Base path en OneDrive donde se guardan los secretos
remote_path: /HMS/secrets

# ID de la aplicación registrada en Azure AD
client_id: "YOUR_CLIENT_ID"

# ID del tenant de Azure AD
tenant_id: "YOUR_TENANT_ID"

# ========== OPCIONALES ==========

# Client secret (para autenticación de aplicación)
# Si no lo necesitas, déjalo vacío
client_secret: ""

# Refresh token (obtenido automáticamente con 'hms setup configure-onedrive')
# NO rellenar manualmente - será generado por el comando
refresh_token: ""

# Nombre del fichero de secretos en OneDrive
# Útil si tienes múltiples entornos (ej: secrets-prod.yml, secrets-dev.yml)
remote_secrets_filename: secrets.yml

# Scope de OAuth (normalmente no cambiar)
# scope: "https://graph.microsoft.com/.default"

