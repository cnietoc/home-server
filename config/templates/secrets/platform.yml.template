# Secretos globales del Home Server
# ==================================
# IMPORTANTE: Este archivo se gestiona en OneDrive
# NO editarlo localmente - los cambios se perderán
# Editar en OneDrive web: [Insertar tu ruta de OneDrive]

cloudflare:
  email: your-email@example.com
  dns_api_token: YOUR_CLOUDFLARE_API_TOKEN

google_oauth:
  client_id: YOUR_GOOGLE_CLIENT_ID
  client_secret: YOUR_GOOGLE_CLIENT_SECRET
  whitelist:
    - your-email@example.com

samba:
  workgroup: WORKGROUP
  users:
    - name: media
      password: YOUR_PASSWORD

watchtower:
  notification_url: ""  # Opcional: webhook para notificaciones

