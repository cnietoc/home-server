#!/usr/bin/env bash
set -euo pipefail

# Ruta base del script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$SCRIPT_DIR/commands"

source "$SCRIPT_DIR/lib/logs.sh"

# ============================================
# HELP
# ============================================

show_help() {
    cat << 'EOF'
🏠 HMS - Home Server Management System

Uso: hms <categoría> <comando> [opciones]

CATEGORÍAS:

📊 show       - Consultar información
   stacks     - Información de stacks ✅
   status     - Estado de deployments 🚧
   logs       - Ver logs 🚧
   config     - Configuración actual 🚧
   health     - Health checks 🚧

🚀 deploy     - Deployment y control
   auto       - Deploy automático (CI/CD) ✅
   up         - Iniciar/deploy stacks 🚧
   down       - Parar stacks 🚧
   restart    - Reiniciar stacks 🚧
   enable     - Habilitar stack 🚧
   disable    - Deshabilitar stack 🚧
   clean      - Deploy limpio 🚧

⚙️  config     - Gestión de configuración
   generate   - Generar archivos .env 🚧
   validate   - Validar configuración 🚧
   link       - Enlaces simbólicos 🚧
   edit       - Editar configuración 🚧

💾 backup     - Gestión de backups
   create     - Crear backup 🚧
   restore    - Restaurar backup 🚧
   list       - Listar backups 🚧
   schedule   - Configurar backups automáticos 🚧

🔧 setup      - Configuración inicial y servicios
   init       - Setup completo inicial 🚧
   docker     - Instalar/configurar Docker 🚧
   networks   - Configurar redes 🚧
   security   - Configurar seguridad 🚧
   ssh        - Configurar SSH 🚧
   nfs        - Gestionar NFS 🚧
   onedrive   - Gestionar OneDrive 🚧

🔨 maintain   - Mantenimiento
   clean      - Limpieza de recursos 🚧
   update     - Actualizar componentes 🚧
   check      - Verificación de salud 🚧
   auto       - Mantenimiento automático 🚧

🛠️  dev        - Herramientas de desarrollo
   test       - Ejecutar tests 🚧
   validate   - Validar todo el sistema 🚧

OPCIONES GLOBALES:
  --version, -v          Mostrar versión
  --help, -h             Mostrar esta ayuda

LEYENDA:
  ✅ Implementado
  🚧 En desarrollo (WIP)

EJEMPLOS:
  hms show stacks                  # Ver configuración de stacks
  hms deploy up platform           # Deploy del stack platform
  hms deploy enable media          # Habilitar stack media
  hms show status                  # Ver estado de todos los stacks
  hms config generate              # Generar archivos .env
  hms backup create                # Crear backup

Para más información sobre un comando específico:
  hms <categoría> <comando> --help

EOF
}

show_version() {
    echo "HMS v0.1.0-alpha"
}

# ============================================
# COMMAND RESOLUTION
# ============================================

# Resuelve dinámicamente el comando a ejecutar navegando por la estructura
# de directorios y archivos en commands/
resolve_command() {
    local current_path="$COMMANDS_DIR"
    local remaining_args=("$@")
    local command_chain=()

    while [[ ${#remaining_args[@]} -gt 0 ]]; do
        local arg="${remaining_args[0]}"

        # Chequear si existe un index en el nivel actual
        local index_path="$current_path/index"
        if [[ -f "$index_path" && -x "$index_path" ]]; then
            logs::debug "Ejecutando index: ${command_chain[*]:-root}/index"
            export HMS_INVOKED=true
            exec "$index_path" "${remaining_args[@]}"
        fi

        # Chequear si existe un comando (archivo) con ese nombre
        local cmd_file="$current_path/$arg"
        if [[ -f "$cmd_file" ]]; then
            if [[ ! -x "$cmd_file" ]]; then
                logs::error "El comando no tiene permisos de ejecución: $cmd_file"
                exit 1
            fi

            command_chain+=("$arg")
            logs::debug "Ejecutando comando: ${command_chain[*]}"
            export HMS_INVOKED=true
            # Ejecutar con los parámetros restantes (sin el comando actual)
            exec "$cmd_file" "${remaining_args[@]:1}"
        fi

        # Chequear si existe un directorio con ese nombre
        local cmd_dir="$current_path/$arg"
        if [[ -d "$cmd_dir" ]]; then
            command_chain+=("$arg")
            current_path="$cmd_dir"
            remaining_args=("${remaining_args[@]:1}")
            continue
        fi

        # No se encontró nada
        if [[ ${#command_chain[@]} -eq 0 ]]; then
            logs::error "Comando no encontrado: $arg"
        else
            logs::error "Subcomando no encontrado: ${command_chain[*]} $arg"
        fi
        echo ""
        echo "Ejecuta 'hms --help' para ver todos los comandos disponibles"
        exit 1
    done

    # Si llegamos aquí, se acabaron los argumentos
    # Intentar ejecutar index en el nivel actual
    local index_path="$current_path/index"
    if [[ -f "$index_path" && -x "$index_path" ]]; then
        if [[ ${#command_chain[@]} -eq 0 ]]; then
            logs::debug "Ejecutando index raíz"
        else
            logs::debug "Ejecutando index: ${command_chain[*]}/index"
        fi
        export HMS_INVOKED=true
        exec "$index_path"
    fi

    # No hay más argumentos y no hay index
    if [[ ${#command_chain[@]} -eq 0 ]]; then
        logs::error "Debes especificar un comando"
    else
        logs::error "Debes especificar un subcomando para: ${command_chain[*]}"
    fi
    echo ""
    echo "Ejecuta 'hms --help' para ver todos los comandos disponibles"
    exit 1
}

# ============================================
# MAIN
# ============================================

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    case "$1" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v|version)
            show_version
            exit 0
            ;;
        *)
            resolve_command "$@"
            ;;
    esac
}

main "$@"
